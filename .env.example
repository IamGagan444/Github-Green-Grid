# Copy to .env (never commit .env). Every value below is required unless marked optional.

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Used for OAuth redirect URIs and CSRF origin checks.
NEXT_PUBLIC_APP_URL=
# PostgreSQL connection string. On Neon use the pooled ("-pooler") host so PgBouncer
# absorbs serverless connection bursts.
DATABASE_URL=
# Optional: connections per serverless instance (default 5).
DATABASE_POOL_MAX=

# ── Auth.js (Google sign-in) ────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud console → OAuth client (Web). Redirect URIs:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/callback/google          (sign-in)
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback  (Connect Google: Sheets + Gmail)
# The same client serves both. Enable the Google Sheets API and Gmail API in the project.
# Scopes requested by Connect Google: openid email profile drive.file gmail.send (no
# restricted scopes, so no paid security assessment).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub App (user-to-server OAuth) ───────────────────────────────────────
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/auth/github/callback
# Permissions: Contents (read & write), Metadata (read), Email addresses (read).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: the App's slug, enables a "Manage repository access" link in Settings.
GITHUB_APP_SLUG=
# Optional: enables GitHub notifications. In the App settings set
#   Webhook URL: ${NEXT_PUBLIC_APP_URL}/api/webhooks/github   and this value as the secret.
# Extra read permissions: Pull requests, Checks, Issues (Contents read is already covered).
# Subscribe to events: Pull request, Check suite, Release, Issues.
GITHUB_WEBHOOK_SECRET=

# ── Slack app ───────────────────────────────────────────────────────────────
# Redirect URL: ${NEXT_PUBLIC_APP_URL}/api/integrations/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional: enables the Events endpoint ${NEXT_PUBLIC_APP_URL}/api/webhooks/slack/events
# (app_uninstalled, tokens_revoked).
SLACK_SIGNING_SECRET=
# Comma-separated. Default when empty:
# chat:write,channels:read,groups:read,channels:history,groups:history,channels:join
SLACK_BOT_SCOPES=
# "Post as me" user scopes, requested in the same Connect as the bot. Default when empty:
# chat:write,channels:read,groups:read,channels:history,groups:history
# Add the same list under "User Token Scopes" in the Slack app. Set to "none" for bot-only.
SLACK_USER_SCOPES=

# ── Instagram (Meta app, "Instagram API with Instagram Login") ─────────────
# App Dashboard → Instagram → API setup with Instagram business login.
# OAuth redirect URL:        ${NEXT_PUBLIC_APP_URL}/api/integrations/instagram/callback
# Webhook callback URL:      ${NEXT_PUBLIC_APP_URL}/api/webhooks/instagram
#   (subscribe to: comments, messages, messaging_postbacks)
# Deauthorize callback URL:  ${NEXT_PUBLIC_APP_URL}/api/instagram/deauthorize
# Data deletion request URL: ${NEXT_PUBLIC_APP_URL}/api/instagram/data-deletion
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any random string; paste the same value as "Verify token" in the webhook setup.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Optional. Default: v25.0
INSTAGRAM_GRAPH_VERSION=

# ── Telegram bot (notification hub) ─────────────────────────────────────────
# Optional. Create a bot with @BotFather, then run `npm run telegram:set-webhook`.
TELEGRAM_BOT_TOKEN=
# The bot's username without @, used for t.me deep links.
TELEGRAM_BOT_USERNAME=
# 16-256 chars of A-Z a-z 0-9 _ - ; Telegram echoes it on every webhook call.
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Free-tier quota caps (optional overrides) ───────────────────────────────
# QUOTA_YOUTUBE_UNITS_PER_USER=200
# QUOTA_YOUTUBE_UNITS_GLOBAL=9000
# QUOTA_EMAILS_PER_USER=100
# QUOTA_TELEGRAM_PER_USER=300

# ── NVIDIA (Nemotron) ───────────────────────────────────────────────────────
# Standup summaries use this key. The notification-hub automations use each user's own
# AI key (Settings → Connections) and fall back to this one only outside production.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Scheduler & crypto ──────────────────────────────────────────────────────
# Shared secret for /api/cron/*; send as "Authorization: Bearer <CRON_SECRET>".
# openssl rand -base64 32
CRON_SECRET=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts OAuth tokens at rest. Changing it makes stored tokens unreadable (users reconnect).
# Existing deployments may keep the legacy name GITHUB_TOKEN_ENCRYPTION_KEY.
ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Upstash Redis: shared rate limits, plus a 5-minute cache of GitHub repositories/branches
# and Slack channel lists. Without it, an in-process fallback is used (fine for local dev).
# If Redis is unreachable the app keeps working: calls time out after 1.5s and Redis is
# skipped for 30s.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# debug | info | warn | error (default: info in production)
LOG_LEVEL=
