// GreenGrid database schema.
// All timestamps are stored in UTC. Timezone-aware logic lives in the app layer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String?
  // Nullable only for accounts created before Google sign-in existed. Every
  // account created through Auth.js has a verified Google email.
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Automation defaults, applied when creating new schedules and automations.
  defaultTimezone      String       @default("UTC")
  defaultCommitMessage String       @default("chore: update GreenGrid activity")
  defaultScheduleTime  String       @default("17:00")
  defaultDaysOfWeek    Weekday[]    @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  defaultMessageStyle  MessageStyle @default(CONCISE)

  accounts              Account[]
  sessions              Session[]
  githubIntegration     GitHubIntegration?
  slackIntegrations     SlackIntegration[]
  instagramIntegrations InstagramIntegration[]
  instagramAutomations  InstagramAutomation[]
  repositories          Repository[]
  schedules             Schedule[]
  automations           Automation[]
  executions            Execution[]
  auditLogs             AuditLog[]             @relation("AuditActor")

  // Notification hub and the automations built on it.
  notificationChannels NotificationChannel[]
  notificationRules    NotificationRule[]
  notificationEvents   NotificationEvent[]
  workflowRuns         WorkflowRun[]
  telegramLinkTokens   TelegramLinkToken[]
  whatsAppLinkTokens   WhatsAppLinkToken[]
  githubInstallations  GitHubInstallation[]
  googleIntegration    GoogleIntegration?
  linkedinIntegration  LinkedInIntegration?
  aiCredential         AiCredential?
  uptimeMonitors       UptimeMonitor[]
  forms                Form[]
  formSubmissions      FormSubmission[]
  receivables          Receivable[]
  reminderSettings     ReminderSettings?
  digestSettings       DigestSettings?
  digestSources        DigestSource[]
  crossPostSources     CrossPostSource[]
  crossPostItems       CrossPostItem[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// OAuth identities used to sign in (Google). Provider tokens are never stored:
/// sign-in needs only the identity, so the adapter discards them.
model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  // SHA-256 of the opaque session token. The raw token only exists in the cookie.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations
// ─────────────────────────────────────────────────────────────────────────────

model GitHubIntegration {
  id     String @id @default(cuid())
  userId String @unique

  githubUserId String            @unique
  username     String
  displayName  String?
  avatarUrl    String?
  email        String?
  status       IntegrationStatus @default(CONNECTED)

  // AES-256-GCM ciphertext. Never leaves the server. Cleared on disconnect.
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String[]  @default([])

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([status])
  @@map("github_integrations")
}

model SlackIntegration {
  id     String @id @default(cuid())
  userId String

  teamId       String
  teamName     String
  teamDomain   String?
  appId        String?
  // Slack user who authorised the install.
  authedUserId String
  botUserId    String?
  status       IntegrationStatus @default(CONNECTED)

  // AES-256-GCM ciphertext. Never leaves the server. Cleared on disconnect.
  botTokenEncrypted         String?
  botRefreshTokenEncrypted  String?
  botTokenExpiresAt         DateTime?
  botScopes                 String[]  @default([])
  // Present only when the user granted user scopes ("Post as me").
  userTokenEncrypted        String?
  userRefreshTokenEncrypted String?
  userTokenExpiresAt        DateTime?
  userScopes                String[]  @default([])

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations Automation[]

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([status])
  @@map("slack_integrations")
}

// ─────────────────────────────────────────────────────────────────────────────
// GreenGrid commit activity
// ─────────────────────────────────────────────────────────────────────────────

model Repository {
  id     String @id @default(cuid())
  userId String

  githubRepositoryId String
  owner              String
  name               String
  fullName           String
  defaultBranch      String
  private            Boolean @default(false)
  archived           Boolean @default(false)
  canPush            Boolean @default(false)
  selected           Boolean @default(false)

  htmlUrl        String?
  lastActivityAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
  executions ActivityExecution[]

  @@unique([userId, githubRepositoryId])
  @@index([userId, selected])
  @@map("repositories")
}

model Schedule {
  id           String @id @default(cuid())
  userId       String
  repositoryId String

  enabled       Boolean   @default(false)
  timezone      String    @default("UTC")
  // 1-20. Commits are spread one per hour across the local day; the exact
  // slot times are derived, never chosen by the user. See lib/schedule/slots.ts.
  commitsPerDay Int       @default(1)
  daysOfWeek    Weekday[]
  commitMessage String    @default("chore: update GreenGrid activity")
  activityPath  String    @default(".greengrid/activity.json")

  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  repository Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  executions ActivityExecution[]

  @@index([userId])
  @@index([enabled])
  @@index([repositoryId])
  @@map("schedules")
}

model ActivityExecution {
  id           String  @id @default(cuid())
  scheduleId   String?
  repositoryId String
  userId       String

  // Local calendar day the run belongs to, as "YYYY-MM-DD" in the schedule timezone.
  scheduledDay String

  // "<scheduleId>:<scheduledDay>:<slotIndex>" for cron runs, NULL for manual runs.
  // A unique index makes duplicate scheduled execution impossible at the DB level;
  // Postgres allows many NULLs, so manual runs are never blocked.
  idempotencyKey String?   @unique
  scheduledFor   DateTime
  executedAt     DateTime?
  durationMs     Int?

  status        ExecutionStatus  @default(PENDING)
  trigger       ExecutionTrigger @default(SCHEDULED)
  commitSha     String?
  commitUrl     String?
  commitMessage String?
  errorCode     String?
  errorMessage  String?

  createdAt DateTime @default(now())

  schedule   Schedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([scheduleId, scheduledDay])
  @@index([repositoryId])
  @@index([status])
  @@map("activity_executions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Standup automations
// ─────────────────────────────────────────────────────────────────────────────

model Automation {
  id             String           @id @default(cuid())
  userId         String
  name           String
  status         AutomationStatus @default(ACTIVE)
  // Set when an admin disables the automation; the owner cannot resume it.
  disabledReason String?

  // GitHub source. `githubSources` is a validated JSON array of
  // { repositoryId, owner, name, fullName, branch | null } — see
  // validators/automation.ts. `branch: null` means all branches.
  githubSources Json
  commitWindow  CommitWindow @default(SAME_DAY)

  // Slack destination.
  slackIntegrationId String?
  slackChannelId     String
  slackChannelName   String
  postingMode        SlackPostingMode @default(BOT)

  // AI.
  messageStyle     MessageStyle @default(CONCISE)
  quickNote        String?
  includeFileStats Boolean      @default(false)

  // Thread.
  threadMode   ThreadMode @default(DATE_HEADER)
  headerFormat String     @default("📅 {date}")

  // Schedule. `scheduleTimes` are sorted, unique "HH:MM" wall-clock times in
  // `timezone` (1–24 per day). Each time posts at most once per day.
  daysOfWeek    Weekday[]
  scheduleTimes String[]
  timezone      String

  lastExecutionAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slackIntegration SlackIntegration? @relation(fields: [slackIntegrationId], references: [id], onDelete: SetNull)
  executions       Execution[]

  @@index([userId])
  @@index([status])
  @@index([slackIntegrationId])
  @@index([createdAt])
  @@map("automations")
}

model Execution {
  id             String  @id @default(cuid())
  // Nullable so history survives automation deletion.
  automationId   String?
  userId         String
  // Snapshot so history remains readable after the automation is renamed or deleted.
  automationName String

  // Local calendar day in the automation timezone, "YYYY-MM-DD".
  executionDate  String
  // "HH:MM" for a scheduled time, "manual-<epochMs>" for Run now. Null on rows
  // created before multiple times per day existed.
  slot           String?
  // "<automationId>:<executionDate>:<slot>". Unique: one Slack update per slot.
  idempotencyKey String     @unique
  // Commits summarised by this execution, [windowStart, windowEnd). Fixed when
  // the execution is created so a retry summarises exactly the same range.
  windowStart    DateTime?
  windowEnd      DateTime?
  trigger        RunTrigger @default(SCHEDULED)
  status         RunStatus  @default(RUNNING)
  attempt        Int        @default(1)
  // Lease held by the worker processing this execution. A RUNNING row whose
  // lease has expired is considered abandoned and may be resumed.
  leaseExpiresAt DateTime?
  nextRetryAt    DateTime?

  // Phase results.
  githubStatus StepStatus @default(PENDING)
  aiStatus     StepStatus @default(PENDING)
  slackStatus  StepStatus @default(PENDING)

  repositories Json?
  commitCount  Int?
  // Validated AI output ({ summary: string[] }) — reused verbatim when resuming
  // so a retry posts exactly the message that was generated.
  aiOutput     Json?
  aiModel      String?
  messageText  String?

  slackTeamId      String?
  slackChannelId   String?
  slackChannelName String?
  slackParentTs    String?
  slackReplyTs     String?
  slackPermalink   String?

  errorCode    String?
  errorMessage String?

  scheduledFor DateTime?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([automationId])
  @@index([status])
  @@index([executionDate])
  @@index([automationId, executionDate])
  @@index([createdAt])
  @@index([status, nextRetryAt])
  @@map("executions")
}

/// One parent message per Slack channel per local day. The unique constraint
/// stops two automations (or two workers) from creating duplicate date headers.
model SlackThreadAnchor {
  id        String   @id @default(cuid())
  teamId    String
  channelId String
  dateKey   String
  // Distinguishes header styles so a date header and an AI parent never collide.
  anchorKey String
  parentTs  String?
  claimedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, channelId, dateKey, anchorKey])
  @@index([createdAt])
  @@map("slack_thread_anchors")
}

// ─────────────────────────────────────────────────────────────────────────────
// Instagram automations (event-driven: Meta webhooks, not the scheduler)
// ─────────────────────────────────────────────────────────────────────────────

/// An Instagram professional account connected via Instagram Login.
model InstagramIntegration {
  id     String @id @default(cuid())
  userId String

  // Instagram professional account ID (the `id` webhooks address as entry.id).
  igUserId          String            @unique
  // App-scoped user ID (`id` from /me). Deauthorize and data-deletion
  // callbacks identify the account by this one.
  appScopedId       String?           @unique
  username          String
  name              String?
  profilePictureUrl String?
  status            IntegrationStatus @default(CONNECTED)

  // AES-256-GCM ciphertext of the long-lived (60 day) token. Refreshed by the
  // Instagram cron before it expires. Cleared on disconnect.
  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  scopes               String[]  @default([])
  webhookSubscribedAt  DateTime?

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations InstagramAutomation[]
  events      InstagramEvent[]

  @@index([userId])
  @@index([status])
  @@index([tokenExpiresAt])
  @@map("instagram_integrations")
}

model InstagramAutomation {
  id            String           @id @default(cuid())
  userId        String
  integrationId String
  name          String
  status        AutomationStatus @default(ACTIVE)

  trigger   InstagramTrigger
  // COMMENT only: restrict to these media IDs. Empty = every post and reel.
  mediaIds  String[]         @default([])
  // Lower-cased. Ignored when matchMode is ANY.
  keywords  String[]         @default([])
  matchMode KeywordMatch     @default(CONTAINS)

  // COMMENT only: public reply under the comment, one variant picked at random.
  publicReplyEnabled Boolean  @default(false)
  publicReplies      String[] @default([])

  // DM. `linkUrl` is sent as a URL button labelled `linkButtonLabel`.
  dmMessage       String
  linkUrl         String?
  linkButtonLabel String  @default("Open link")

  // Follow-gate: the first DM only asks to follow; the link is sent once a
  // button tap confirms the person follows the account.
  followGateEnabled Boolean @default(false)
  followGateMessage String  @default("Follow us first, then tap the button below to get the link 👇")
  followButtonLabel String  @default("I'm following ✅")

  triggeredCount Int @default(0)
  sentCount      Int @default(0)
  clickCount     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration InstagramIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  events      InstagramEvent[]

  @@index([userId])
  @@index([integrationId, status, trigger])
  @@map("instagram_automations")
}

/// Webhook inbox and execution record. One row per Meta event; the unique
/// idempotency key absorbs Meta's redeliveries.
model InstagramEvent {
  id            String  @id @default(cuid())
  integrationId String
  automationId  String?

  // "comment:<id>" | "message:<mid>" | "postback:<mid>"
  idempotencyKey String             @unique
  type           InstagramEventType
  senderIgsid    String
  senderUsername String?
  // COMMENT: comment id. Messages: mid.
  sourceId       String
  mediaId        String?
  text           String?
  // When Meta says the comment/message was created. Private replies must be
  // sent within 7 days of a comment.
  occurredAt     DateTime

  status         RunStatus @default(RUNNING)
  attempt        Int       @default(0)
  leaseExpiresAt DateTime?
  nextRetryAt    DateTime?

  publicReplyStatus StepStatus @default(PENDING)
  dmStatus          StepStatus @default(PENDING)
  linkStatus        StepStatus @default(PENDING)

  publicReplyId String?
  dmMessageId   String?
  errorCode     String?
  errorMessage  String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  integration InstagramIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  automation  InstagramAutomation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@index([integrationId, createdAt])
  @@index([automationId, createdAt])
  @@index([status, nextRetryAt])
  @@index([integrationId, senderIgsid])
  @@map("instagram_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification hub: event in → rules → message out on free channels
// ─────────────────────────────────────────────────────────────────────────────

/// A place GreenGrid can deliver a message to. `configEncrypted` is AES-256-GCM
/// ciphertext of a JSON object validated per kind (lib/hub/channel-config.ts):
/// a Telegram chat id, a Discord webhook URL (itself a secret), a Slack
/// integration + channel, or an email address.
model NotificationChannel {
  id     String      @id @default(cuid())
  userId String
  kind   ChannelKind
  label  String

  configEncrypted String
  // HMAC of the provider-side identity (Telegram chat id, webhook URL, …) so a
  // channel can be found and de-duplicated without decrypting every row.
  externalRef     String
  verified        Boolean   @default(false)
  verifiedAt      DateTime?
  lastError       String?
  lastDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets NotificationRuleTarget[]

  @@unique([userId, kind, externalRef])
  @@index([userId])
  @@index([kind, externalRef])
  @@map("notification_channels")
}

model NotificationRule {
  id      String             @id @default(cuid())
  userId  String
  name    String
  source  NotificationSource
  // Validated per source (lib/hub/rules.ts), e.g. { events: [...], repositories: [...] }.
  filter  Json
  enabled Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets NotificationRuleTarget[]

  @@index([userId, source, enabled])
  @@map("notification_rules")
}

model NotificationRuleTarget {
  ruleId    String
  channelId String

  rule    NotificationRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([ruleId, channelId])
  @@index([channelId])
  @@map("notification_rule_targets")
}

/// Inbox for everything that can trigger a notification. The raw provider
/// payload is never stored: `data` is a small normalised object.
model NotificationEvent {
  id             String             @id @default(cuid())
  userId         String
  source         NotificationSource
  // e.g. "pull_request.opened", "uptime.down".
  type           String
  // "gh:<delivery>" | "uptime:<monitor>:<state>:<at>" | … Unique: redeliveries are absorbed.
  idempotencyKey String             @unique
  data           Json
  occurredAt     DateTime           @default(now())
  // Set once one WorkflowRun per matching rule exists. Null rows are swept by the cron.
  fannedOutAt    DateTime?
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fannedOutAt, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notification_events")
}

/// One unit of work for the generic workflow engine (lib/workflow). Claimed
/// with a lease, retried with backoff; every step is recorded separately.
model WorkflowRun {
  id             String       @id @default(cuid())
  userId         String
  kind           WorkflowKind
  // "notify:<eventId>:<ruleId>" | "reminder:<receivableId>:<date>" | …
  idempotencyKey String       @unique
  // What the run is about, for per-object history ("NotificationEvent", "Form", …).
  subjectType    String?
  subjectId      String?
  title          String
  // Small kind-specific input (ids, not content).
  input          Json?

  status         RunStatus  @default(RUNNING)
  trigger        RunTrigger @default(SCHEDULED)
  attempt        Int        @default(0)
  leaseExpiresAt DateTime?
  nextRetryAt    DateTime?

  scheduledFor DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps WorkflowStep[]

  @@index([status, nextRetryAt])
  @@index([userId, createdAt])
  @@index([subjectType, subjectId])
  @@index([createdAt])
  @@map("workflow_runs")
}

model WorkflowStep {
  id             String             @id @default(cuid())
  runId          String
  // Stable within the run: "notify:<channelId>", "sheet.append", "publish:linkedin".
  key            String
  // Globally unique, e.g. "notify:<eventId>:<ruleId>:<channelId>".
  idempotencyKey String             @unique
  position       Int                @default(0)
  semantics      DeliverySemantics  @default(AT_LEAST_ONCE)
  status         WorkflowStepStatus @default(PENDING)
  attempt        Int                @default(0)
  // Input needed to (re)execute the step. Cleared once the step succeeds and
  // by the retention job after 30 days.
  payload        Json?
  // Provider references (message id, post URN, row range). Never content.
  result         Json?
  externalId     String?
  errorCode      String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, key])
  @@index([createdAt])
  @@map("workflow_steps")
}

/// Single-use, 15-minute token behind the "Connect Telegram" deep link.
model TelegramLinkToken {
  id         String    @id @default(cuid())
  userId     String
  // SHA-256 of the token; the raw token only exists in the t.me link.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_link_tokens")
}

/// Single-use code a user sends to the GreenGrid WhatsApp number to prove they
/// own the phone. Sending it opens a free, user-initiated conversation.
model WhatsAppLinkToken {
  id         String    @id @default(cuid())
  userId     String
  // SHA-256 of the code; the raw code only exists in the wa.me link.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("whatsapp_link_tokens")
}

/// A GitHub App installation. Webhook deliveries carry the installation id,
/// which routes the event to the GreenGrid user who installed the App.
model GitHubInstallation {
  id                  String    @id @default(cuid())
  installationId      String    @unique
  userId              String?
  accountId           String
  accountLogin        String
  accountType         String
  repositorySelection String?
  suspendedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([accountId])
  @@map("github_installations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Integrations used by the hub automations
// ─────────────────────────────────────────────────────────────────────────────

/// Google connection for Sheets (drive.file) and Gmail (gmail.send). Separate
/// from sign-in: sign-in never stores Google tokens.
model GoogleIntegration {
  id     String @id @default(cuid())
  userId String @unique

  googleSub String
  email     String
  status    IntegrationStatus @default(CONNECTED)

  // AES-256-GCM ciphertext. Cleared on disconnect.
  refreshTokenEncrypted String?
  accessTokenEncrypted  String?
  tokenExpiresAt        DateTime?
  scopes                String[]  @default([])

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("google_integrations")
}

/// "Share on LinkedIn" (w_member_social). LinkedIn issues no refresh token to
/// self-serve apps, so the 60-day token is replaced by reconnecting.
model LinkedInIntegration {
  id     String @id @default(cuid())
  userId String @unique

  // OIDC `sub`; the post author is urn:li:person:<memberSub>.
  memberSub String
  name      String?
  status    IntegrationStatus @default(CONNECTED)

  accessTokenEncrypted String?
  tokenExpiresAt       DateTime?
  expiryWarnedAt       DateTime?
  scopes               String[]  @default([])

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, tokenExpiresAt])
  @@map("linkedin_integrations")
}

/// Bring-your-own-key AI: any OpenAI-compatible endpoint.
model AiCredential {
  id     String @id @default(cuid())
  userId String @unique

  label          String
  baseUrl        String
  model          String
  keyEncrypted   String
  lastVerifiedAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_credentials")
}

model UptimeMonitor {
  id      String  @id @default(cuid())
  userId  String
  url     String
  label   String
  enabled Boolean @default(true)

  state               MonitorState @default(UNKNOWN)
  consecutiveFailures Int          @default(0)
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime     @default(now())
  lastStatusCode      Int?
  lastLatencyMs       Int?
  lastError           String?
  lastChangeAt        DateTime?

  // TLS certificate expiry, checked daily for https URLs.
  tlsExpiresAt  DateTime?
  tlsCheckedAt  DateTime?
  // Smallest threshold already alerted for the current certificate (14, then 3).
  tlsAlertLevel Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextCheckAt])
  @@index([userId])
  @@map("uptime_monitors")
}

// ─────────────────────────────────────────────────────────────────────────────
// Form → Google Sheet → alert
// ─────────────────────────────────────────────────────────────────────────────

model Form {
  id              String           @id @default(cuid())
  userId          String
  // Random, unguessable id used in the public URL /f/<publicId>.
  publicId        String           @unique
  name            String
  status          AutomationStatus @default(ACTIVE)
  // Validated array of { id, label, type, required, options? } (validators/form.ts).
  fields          Json
  thankYouMessage String           @default("Thanks! We received your response.")

  spreadsheetId String?
  sheetUrl      String?

  // Optional acknowledgement email to the submitter, sent from the owner's Gmail.
  ackEnabled     Boolean  @default(false)
  ackSubject     String?
  ackBody        String?
  // Origins allowed to POST from the owner's own site. Empty = any origin.
  allowedOrigins String[] @default([])
  // Notification channels alerted on each response (owned by the same user; checked on every send).
  channelIds     String[] @default([])

  submissionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions FormSubmission[]

  @@index([userId])
  @@map("forms")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  userId    String
  data      Json
  // HMAC of the client IP: enough for abuse limits, not reversible.
  ipHash    String?
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
  @@index([createdAt])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment and invoice reminders
// ─────────────────────────────────────────────────────────────────────────────

model Receivable {
  id           String           @id @default(cuid())
  userId       String
  customerName String
  email        String?
  // E.164, e.g. +919876543210.
  phone        String?
  // Minor units (paise, cents). Never a float.
  amountMinor  Int
  currency     String           @default("INR")
  // Local calendar day in the owner's reminder timezone, "YYYY-MM-DD".
  dueDate      String
  note         String?
  status       ReceivableStatus @default(OPEN)
  paymentLink  String?

  intervalDays   Int       @default(3)
  maxReminders   Int       @default(3)
  remindersSent  Int       @default(0)
  // Next local day a reminder is due; null once the schedule is exhausted.
  nextReminderOn String?
  lastRemindedAt DateTime?
  paidAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextReminderOn])
  @@index([userId, status])
  @@map("receivables")
}

model ReminderSettings {
  id            String  @id @default(cuid())
  userId        String  @unique
  enabled       Boolean @default(true)
  timezone      String  @default("Asia/Kolkata")
  // Local hour (0–23) reminders go out.
  hour          Int     @default(10)
  upiId         String?
  payeeName     String?
  emailSubject  String  @default("Payment reminder: {amount} due {dueDate}")
  emailTemplate String  @default("Hi {name},\n\nThis is a friendly reminder that {amount} is due on {dueDate}.\n\nThank you!")
  // Channels that get the owner's copy (with the one-tap WhatsApp button).
  channelIds    String[] @default([])
  // Local day the last batch ran, so each day runs once.
  lastRunDate   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI morning digest
// ─────────────────────────────────────────────────────────────────────────────

model DigestSettings {
  id            String    @id @default(cuid())
  userId        String    @unique
  enabled       Boolean   @default(true)
  timezone      String    @default("UTC")
  daysOfWeek    Weekday[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY, SUNDAY])
  scheduleTimes String[]  @default(["08:00"])
  maxItems      Int       @default(30)
  // Notification channels the digest is sent to (owned by the same user; checked on every send).
  channelIds    String[]  @default([])
  lastRunDate   String?
  lastRunAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("digest_settings")
}

model DigestSource {
  id      String           @id @default(cuid())
  userId  String
  kind    DigestSourceKind
  label   String
  // { url } | { channelId, handle? } | { owner, repo } | { topN }
  config  Json
  enabled Boolean          @default(true)

  // Conditional GET state.
  etag              String?
  lastModified      String?
  // Resolved once for YOUTUBE_CHANNEL sources.
  resolvedChannelId String?
  // Hashes of items already delivered (newest 300).
  seenKeys          String[]  @default([])
  lastFetchedAt     DateTime?
  failureCount      Int       @default(0)
  lastError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@map("digest_sources")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cross-poster
// ─────────────────────────────────────────────────────────────────────────────

model CrossPostSource {
  id      String              @id @default(cuid())
  userId  String
  kind    CrossPostSourceKind
  label   String
  config  Json
  mode    CrossPostMode       @default(APPROVAL)
  // Validated array of targets (validators/crosspost.ts).
  targets Json
  enabled Boolean             @default(true)

  etag              String?
  lastModified      String?
  resolvedChannelId String?
  uploadsPlaylistId String?
  // Items published before this instant are never posted (no backlog flood).
  baselineAt        DateTime  @default(now())
  lastPolledAt      DateTime?
  nextPollAt        DateTime  @default(now())
  failureCount      Int       @default(0)
  lastError         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CrossPostItem[]

  @@index([enabled, nextPollAt])
  @@index([userId])
  @@map("crosspost_sources")
}

model CrossPostItem {
  id                String              @id @default(cuid())
  sourceId          String
  userId            String
  // Video id or feed guid.
  externalId        String
  title             String
  url               String
  publishedAt       DateTime?
  status            CrossPostItemStatus @default(NEW)
  // { LINKEDIN: "...", TELEGRAM_CHANNEL: "...", DISCORD: "..." }
  drafts            Json?
  approvedAt        DateTime?
  approvalMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  source CrossPostSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("crosspost_items")
}

/// Daily usage of shared free-tier quotas. `subject` is a user id or "global".
/// Reservations are compare-and-swap increments, so caps hold under concurrency.
model QuotaUsage {
  id      String     @id @default(cuid())
  scope   QuotaScope
  subject String
  // "YYYY-MM-DD" in the quota's reset timezone (Pacific for YouTube).
  day     String
  used    Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, subject, day])
  @@index([day])
  @@map("quota_usage")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit & operations
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  targetType  String
  targetId    String?
  // Never contains tokens or secrets — sanitised by the audit service.
  metadata    Json?
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model CronRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  processed  Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  skipped    Int       @default(0)
  error      String?

  @@index([job, startedAt])
  @@map("cron_runs")
}

